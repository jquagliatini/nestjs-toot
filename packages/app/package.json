{
  "name": "cc.jqgl.app",
  "version": "0.0.0",
  "files": [
    "i18n",
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*.js": "./dist/*.js"
  },
  "exports": {
    ".": {
      "import": "./dist/app.module.js",
      "types": "./src/app.module.ts"
    },
    "./config": {
      "import": "./dist/config.js",
      "types": "./src/config.ts"
    }
  },
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf ./dist",
    "prebuild": "rm -rf ./dist",
    "build": "tsc -p tsconfig.build.json",
    "beforedb:mig:create": "pnpm build",
    "db:create": "pnpm drizzle-kit generate --name",
    "beforedb:mig:deploy": "pnpm build",
    "db:deploy": "pnpm drizzle-kit migrate",
    "test": "vitest run"
  },
  "dependencies": {
    "@jqgl.cc/config": "workspace:cc.jqgl.internal.config@*",
    "@jqgl.cc/dispatchable": "workspace:cc.jqgl.internal.dispatchable@*",
    "@jqgl.cc/humanid": "workspace:cc.jqgl.internal.humanid@*",
    "@jqgl.cc/messages": "workspace:cc.jqgl.internal.messages@*",
    "@nestjs-cls/transactional": "4.0.2",
    "@nestjs-cls/transactional-adapter-drizzle-orm": "2.0.2",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/drizzle": "0.0.2",
    "@nestjs/http-client": "0.0.2",
    "@nestjs/i18n": "catalog:",
    "@nestjs/observe": "0.3.21",
    "@nestjs/outbox": "0.1.4",
    "@nestjs/platform-node": "12.4.2",
    "@nestjs/resilience": "0.0.3",
    "@nestjs/storage": "0.0.4",
    "@nestjs/swagger": "12.0.5",
    "@vitest/coverage-v8": "5.1.0",
    "drizzle-orm": "1.0.0-rc.5",
    "nestjs-cls": "7.0.2",
    "pg": "8.23.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "cc.jqgl.internal.tsconfig": "workspace:*",
    "drizzle-kit": "1.0.0-rc.5",
    "vitest": "catalog:",
    "vitest-mock-extended": "5.1.1"
  }
}
